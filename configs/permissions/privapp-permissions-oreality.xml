<!--
    ORealityControl is /system/priv-app. The privileged permission allowlist
    must therefore live on /system, which is what system: true selects.
-->
<permissions>
    <privapp-permissions package="com.oplus.oreality.audio">
        <!-- Create/own the AudioX and spatializer effects on the global mix. -->
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
        <!-- android.media.Spatializer setEnabled/setEffectParameter. -->
        <permission name="android.permission.MODIFY_DEFAULT_AUDIO_EFFECTS" />
        <!-- Persist the selected profile across users and boots. -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <!-- Observe the per-user profile that the service restores. -->
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
    </privapp-permissions>
</permissions>
